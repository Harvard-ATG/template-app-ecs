# Application Settings
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=dev-secret-change-in-production
APP_COOKIE_SECURE=false

# Database
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_NAME=app_db
APP_DB_USER=app_user
APP_DB_PASSWORD=dev_password

# LLM Configuration (OPTIONAL)
# Leave commented out or empty to disable LLM features
# Get your API key from: https://console.anthropic.com
# APP_ANTHROPIC_API_KEY=your-anthropic-api-key-here
APP_DEFAULT_MODEL=claude-opus-4-8
APP_MAX_TOKENS=4096
APP_TEMPERATURE=0.7

# CORS
APP_ALLOWED_ORIGINS=["http://localhost:3000"]

# Frontend
API_BASE_URL=http://localhost:8000
